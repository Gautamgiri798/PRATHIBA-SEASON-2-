# Passcode required to access the results dashboard at `/admin`.
ADMIN_PASSCODE=your-secret-admin-passcode-here

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/pratibha_db

# Multiplier for public total voters display (Formula: n * 2 + 1)
NEXT_PUBLIC_VOTE_MULTIPLIER=2

# WhatsApp number for screenshot verification
NEXT_PUBLIC_WHATSAPP_NUMBER=your-whatsapp-number-here
NEXT_PUBLIC_WHATSAPP_GROUP_LINK=your-whatsapp-group-link-here




